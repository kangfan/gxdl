using Gxdl.Modules;
using UnityEditor;
using UnityEngine;
using UnityEngine.UI;

namespace Gxdl.EditorTools
{
    /// <summary>
    /// 战前准备 prefab 生成器。
    /// 骨架照 GxdlGame.DrawBattlePreparation 的 940x1672 构图还原，
    /// 舞台名、敌人属性、奖励与评估由 BattlePrepView.Apply 运行时填入。
    /// </summary>
    [InitializeOnLoad]
    public static class BattlePrepPrefabSource
    {
        public const string PrefabPath = "Assets/Resources/" + UiScreens.BattlePrep + ".prefab";

        const float PanelWidth = 940f;
        const float PanelHeight = 1672f;

        static readonly Color Ink = new Color(0.08f, 0.12f, 0.12f);
        static readonly Color PaleGold = new Color(1f, 0.88f, 0.58f);

        static BattlePrepPrefabSource()
        {
            ScreenPrefabKit.Register("BattlePrep", Build);
        }

        [MenuItem("Gxdl/UI/生成/战前准备", priority = 302)]
        public static void Generate()
        {
            var path = Build();
            if (path != null) EditorUtility.DisplayDialog("生成完成", "已生成\n" + path, "确定");
        }

        public static string Build()
        {
            using (var builder = new UiPrefabBuilder("BattlePrepView",
                new Vector2(UiRootLayout.DesignWidth, UiRootLayout.DesignHeight)))
            {
                var root = builder.Root;
                AnchorUtility.Apply(root, AnchorPreset.Stretch, Vector2.zero, Vector2.zero);
                ScreenPrefabKit.AddRootComponents(root);

                // 整屏遮罩：阻断背后的章节界面点击，换分辨率时铺满。
                var shade = builder.AnchoredNode("", "Prep Shade", AnchorPreset.Stretch, Vector2.zero);
                var shadeImage = shade.gameObject.AddComponent<Image>();
                shadeImage.color = new Color(0.025f, 0.075f, 0.10f, 0.74f);
                shadeImage.raycastTarget = true;

                // 原构图整体居中；父级按 750 宽锁宽，等比缩放后比例不变。
                var panel = builder.AnchoredNode("", "Battle Preparation", AnchorPreset.Center,
                    new Vector2(PanelWidth, PanelHeight));
                BuildFrame(builder, panel);
                BuildEnemy(builder);
                BuildRewards(builder);
                BuildSkills(builder);
                BuildFooter(builder);

                var path = builder.Save(PrefabPath);
                AssetDatabase.SaveAssets();
                if (path != null) Bind(path);
                return path;
            }
        }

        static void BuildFrame(UiPrefabBuilder builder, RectTransform panel)
        {
            var skin = builder.ImageNode("", "Battle Preparation Skin", 0f, 0f, PanelWidth, PanelHeight,
                new Color(0.02f, 0.07f, 0.09f, 0.97f));
            skin.raycastTarget = false;

            var title = builder.TextNode("", "Prep Stage", 267f, 152f, 470f, 62f, string.Empty, 44, PaleGold,
                TextAnchor.MiddleCenter);
            Fit(title);

            var close = builder.Node("", "Prep Close", 784f, 167f, 70f, 69f);
            var closeImage = close.gameObject.AddComponent<Image>();
            closeImage.color = Color.clear;
            closeImage.raycastTarget = true;
            close.gameObject.AddComponent<Button>().targetGraphic = closeImage;
            builder.TextNode("Prep Close", "Label", 0f, 0f, 70f, 69f, "‹ 古墟", 22, ScreenPrefabKit.Cream,
                TextAnchor.MiddleCenter);
        }

        static void BuildEnemy(UiPrefabBuilder builder)
        {
            var guardian = builder.TextNode("", "Prep Guardian", 305f, 368f, 330f, 62f, string.Empty, 48, Ink,
                TextAnchor.MiddleCenter);
            Fit(guardian);

            // 敌方特性图标占位，真实图标由界面主题资源提供。
            builder.ImageNode("", "Prep Trait Icon", 157f, 428f, 40f, 40f, new Color(0.08f, 0.24f, 0.23f));
            builder.TextNode("", "Prep Trait Label", 198f, 430f, 147f, 36f, "敌方特性", 25, ScreenPrefabKit.Cream);

            var mechanic = builder.TextNode("", "Prep Mechanic", 198f, 473f, 557f, 32f, string.Empty, 27, Ink,
                TextAnchor.MiddleLeft);
            Fit(mechanic);
            var wave = builder.TextNode("", "Prep Wave", 198f, 503f, 557f, 30f, string.Empty, 26, Ink,
                TextAnchor.MiddleLeft);
            Fit(wave);

            Fit(builder.TextNode("", "Prep Enemy Attack", 214f, 544f, 132f, 37f, string.Empty, 28, Ink,
                TextAnchor.MiddleLeft));
            Fit(builder.TextNode("", "Prep Enemy HP", 431f, 544f, 144f, 37f, string.Empty, 28, Ink,
                TextAnchor.MiddleLeft));
            Fit(builder.TextNode("", "Prep Enemy Defense", 665f, 544f, 125f, 37f, string.Empty, 28, Ink,
                TextAnchor.MiddleLeft));
        }

        static void BuildRewards(UiPrefabBuilder builder)
        {
            var title = builder.TextNode("", "Prep Reward Title", 198f, 606f, 164f, 37f, string.Empty, 25,
                ScreenPrefabKit.Cream, TextAnchor.MiddleCenter);
            Fit(title);

            var limit = builder.TextNode("", "Prep Reward Limit", 407f, 606f, 355f, 37f, string.Empty, 25, Ink,
                TextAnchor.MiddleRight);
            Fit(limit);

            // 三列两行：最多七种产出，位置固定，避免运行时按数量重排。
            for (var i = 0; i < 6; i++)
            {
                var x = 165f + i % 3 * 216f;
                var y = 648f + i / 3 * 34f;
                var slot = builder.Node("", "Prep Reward Slot " + i, x, y, 400f, 40f);
                builder.ImageNode("Prep Reward Slot " + i, "Icon", 0f, 0f, 36f, 36f, Color.white);
                var label = builder.TextNode("Prep Reward Slot " + i, "Label", 36f, 0f, 150f, 36f, string.Empty, 25,
                    Ink, TextAnchor.MiddleLeft);
                Fit(label);
                var value = builder.TextNode("Prep Reward Slot " + i, "Value", 188f, 0f, 120f, 36f, string.Empty, 25,
                    Ink, TextAnchor.MiddleLeft);
                Fit(value);
                slot.gameObject.SetActive(false);
            }

            var none = builder.TextNode("", "Prep No Reward", 200f, 651f, 540f, 48f, "本层首通奖励已领取", 27, Ink);
            Fit(none);
        }

        static void BuildSkills(UiPrefabBuilder builder)
        {
            builder.TextNode("", "Prep Skill Heading", 200f, 724f, 115f, 39f, "出战技能", 27, ScreenPrefabKit.Cream);
            var hint = builder.TextNode("", "Prep Skill Hint", 381f, 725f, 329f, 38f, "天赋、装备词条与灵玉自动生效。", 25,
                Ink, TextAnchor.MiddleLeft);
            Fit(hint);

            for (var i = 0; i < 4; i++)
            {
                var x = 134f + i % 2 * 345f;
                var y = 798f + i / 2 * 99f;
                var card = builder.Node("", "Skill Choice " + i, x, y, 330f, 94f);
                var cardImage = card.gameObject.AddComponent<Image>();
                cardImage.color = new Color(0.12f, 0.22f, 0.22f, 0.94f);
                cardImage.raycastTarget = true;
                var button = card.gameObject.AddComponent<Button>();
                button.targetGraphic = cardImage;

                var icon = builder.ImageNode("Skill Choice " + i, "Icon", 22f, -5f, 104f, 104f,
                    new Color(0.67f, 0.96f, 1f));
                icon.raycastTarget = false;

                // 选中标记：金色圆环 + 深金内盘 + 对勾。
                var check = builder.Node("Skill Choice " + i, "Selected", 284f, 1f, 40f, 40f);
                var rim = check.gameObject.AddComponent<GuxuPortraitDisc>();
                rim.color = new Color(1f, 0.88f, 0.52f);
                rim.raycastTarget = false;
                var center = builder.Node("Skill Choice " + i + "/Selected", "Gold", 3f, 3f, 34f, 34f);
                var disc = center.gameObject.AddComponent<GuxuPortraitDisc>();
                disc.color = new Color(0.72f, 0.42f, 0.06f);
                disc.raycastTarget = false;
                builder.TextNode("Skill Choice " + i + "/Selected", "Tick", 4f, 0f, 32f, 37f, "✓", 31, Color.white,
                    TextAnchor.MiddleCenter);
                check.gameObject.SetActive(i == 0);

                var name = builder.TextNode("Skill Choice " + i, "Name", 135f, 11f, 164f, 68f, string.Empty, 36,
                    ScreenPrefabKit.Cream, TextAnchor.MiddleLeft);
                Fit(name);
            }

            var detail = builder.TextNode("", "Prep Skill Detail", 190f, 986f, 565f, 62f, string.Empty, 23, Ink,
                TextAnchor.MiddleCenter);
            Fit(detail);

            // 整条区域可点，文案由控制器回填，因此不挂子文本按钮。
            var mode = builder.Node("", "Prep Auto Skill", 180f, 1046f, 581f, 54f);
            var modeImage = mode.gameObject.AddComponent<Image>();
            modeImage.color = Color.clear;
            modeImage.raycastTarget = true;
            mode.gameObject.AddComponent<Button>().targetGraphic = modeImage;
            var modeText = builder.TextNode("Prep Auto Skill", "Label", 0f, 0f, 581f, 54f, string.Empty, 27,
                ScreenPrefabKit.Cream, TextAnchor.MiddleCenter);
            Fit(modeText);

            builder.TextNode("", "Prep Power Label", 399f, 1111f, 142f, 39f, "基础战力", 30, Ink, TextAnchor.MiddleCenter);
            Fit(builder.TextNode("", "Prep Power", 437f, 1148f, 158f, 55f, string.Empty, 42,
                new Color(0.12f, 0.32f, 0.30f), TextAnchor.MiddleLeft));

            Fit(builder.TextNode("", "Prep Critical", 247f, 1210f, 131f, 41f, string.Empty, 29, Ink, TextAnchor.MiddleCenter));
            Fit(builder.TextNode("", "Prep Combo", 448f, 1210f, 116f, 41f, string.Empty, 29, Ink, TextAnchor.MiddleCenter));
            Fit(builder.TextNode("", "Prep Counter", 642f, 1210f, 116f, 41f, string.Empty, 29, Ink, TextAnchor.MiddleCenter));
            Fit(builder.TextNode("", "Prep Assessment", 155f, 1381f, 650f, 42f, string.Empty, 29, Ink));
            Fit(builder.TextNode("", "Prep Assessment Conditions", 145f, 1425f, 670f, 46f,
                "当前配装 / 自动释放抽样估计，手动时机影响结果", 24, Ink));
        }

        static void BuildFooter(UiPrefabBuilder builder)
        {
            builder.TextNode("", "Prep Growth Label", 157f, 1300f, 270f, 54f, "调整养成", 34, ScreenPrefabKit.Cream,
                TextAnchor.MiddleCenter);
            AddHit(builder, "", "Prep Growth", 134f, 1290f, 315f, 74f);

            var challenge = builder.TextNode("", "Prep Challenge Label", 490f, 1300f, 305f, 54f, "开始挑战", 34,
                new Color(0.18f, 0.09f, 0.02f), TextAnchor.MiddleCenter);
            challenge.name = "Prep Challenge Label";
            Fit(challenge);
            var hit = AddHit(builder, "", "Ruins Challenge", 474f, 1290f, 339f, 74f);

            // 不可挑战时的压暗层，默认隐藏，由 SetChallenge 控制。
            var block = builder.ImageNode("", "Prep Challenge Block", 481f, 1297f, 323f, 59f,
                new Color(0.03f, 0.06f, 0.08f, 0.35f));
            block.raycastTarget = false;
            block.rectTransform.SetAsLastSibling();
            block.gameObject.SetActive(false);
        }

        static Button AddHit(UiPrefabBuilder builder, string parent, string name, float x, float y, float width, float height)
        {
            var node = builder.Node(parent, name, x, y, width, height);
            var image = node.gameObject.AddComponent<Image>();
            image.color = Color.clear;
            image.raycastTarget = true;
            var button = node.gameObject.AddComponent<Button>();
            button.targetGraphic = image;
            return button;
        }

        /// <summary>原界面用 resizeTextForBestFit，prefab 同步保留，长文案不撑破版面。</summary>
        static void Fit(Text text)
        {
            if (text == null) return;
            text.resizeTextForBestFit = true;
            text.resizeTextMinSize = Mathf.Max(18, text.fontSize * 2 / 3);
            text.resizeTextMaxSize = text.fontSize;
        }

        static void Bind(string prefabPath)
        {
            var contents = PrefabUtility.LoadPrefabContents(prefabPath);
            if (contents == null) return;
            try
            {
                var view = contents.GetComponent<BattlePrepView>();
                if (view == null) view = contents.AddComponent<BattlePrepView>();

                var so = new SerializedObject(view);
                Set(so, "stageNameText", FindText(contents, "Prep Stage"));
                Set(so, "closeButton", Find(contents, "Prep Close")?.GetComponent<Button>());
                Set(so, "guardianText", FindText(contents, "Prep Guardian"));
                Set(so, "mechanicText", FindText(contents, "Prep Mechanic"));
                Set(so, "waveText", FindText(contents, "Prep Wave"));
                Set(so, "attackText", FindText(contents, "Prep Enemy Attack"));
                Set(so, "hpText", FindText(contents, "Prep Enemy HP"));
                Set(so, "defenseText", FindText(contents, "Prep Enemy Defense"));
                Set(so, "rewardTitleText", FindText(contents, "Prep Reward Title"));
                Set(so, "rewardLimitText", FindText(contents, "Prep Reward Limit"));
                Set(so, "noRewardText", FindText(contents, "Prep No Reward"));
                Set(so, "skillDetailText", FindText(contents, "Prep Skill Detail"));
                Set(so, "autoSkillButton", Find(contents, "Prep Auto Skill")?.GetComponent<Button>());
                Set(so, "skillModeText", FindText(contents, "Prep Auto Skill/Label"));
                Set(so, "assessmentText", FindText(contents, "Prep Assessment"));
                Set(so, "powerText", FindText(contents, "Prep Power"));
                Set(so, "criticalText", FindText(contents, "Prep Critical"));
                Set(so, "comboText", FindText(contents, "Prep Combo"));
                Set(so, "counterText", FindText(contents, "Prep Counter"));
                Set(so, "growthButton", Find(contents, "Prep Growth")?.GetComponent<Button>());
                Set(so, "challengeButton", Find(contents, "Ruins Challenge")?.GetComponent<Button>());
                Set(so, "challengeLabel", FindText(contents, "Prep Challenge Label"));
                Set(so, "challengeBlock", Find(contents, "Prep Challenge Block"));

                var slots = new System.Collections.Generic.List<GameObject>();
                var icons = new System.Collections.Generic.List<Image>();
                var labels = new System.Collections.Generic.List<Text>();
                var values = new System.Collections.Generic.List<Text>();
                for (var i = 0; i < 6; i++)
                {
                    var path = "Prep Reward Slot " + i;
                    var slot = Find(contents, path);
                    slots.Add(slot != null ? slot.gameObject : null);
                    icons.Add(Find(contents, path + "/Icon")?.GetComponent<Image>());
                    labels.Add(FindText(contents, path + "/Label"));
                    values.Add(FindText(contents, path + "/Value"));
                }
                SetArray(so, "rewardSlots", slots);
                SetArray(so, "rewardIcons", icons);
                SetArray(so, "rewardLabels", labels);
                SetArray(so, "rewardValues", values);

                var buttons = new System.Collections.Generic.List<Button>();
                var skillIcons = new System.Collections.Generic.List<Image>();
                var checks = new System.Collections.Generic.List<GameObject>();
                for (var i = 0; i < 4; i++)
                {
                    var path = "Skill Choice " + i;
                    buttons.Add(Find(contents, path)?.GetComponent<Button>());
                    skillIcons.Add(Find(contents, path + "/Icon")?.GetComponent<Image>());
                    var check = Find(contents, path + "/Selected");
                    checks.Add(check != null ? check.gameObject : null);
                }
                SetArray(so, "skillButtons", buttons);
                SetArray(so, "skillIcons", skillIcons);
                SetArray(so, "skillChecks", checks);
                so.ApplyModifiedPropertiesWithoutUndo();

                PrefabUtility.SaveAsPrefabAsset(contents, prefabPath);
                AssetDatabase.SaveAssets();
                Debug.Log("[BattlePrep] 已生成并绑定 " + prefabPath);
            }
            finally
            {
                PrefabUtility.UnloadPrefabContents(contents);
            }
        }

        static Transform Find(GameObject root, string path) => root.transform.Find(path);

        static Text FindText(GameObject root, string path)
        {
            var node = Find(root, path);
            return node != null ? node.GetComponent<Text>() : null;
        }

        static void Set(SerializedObject so, string field, Object value)
        {
            var property = so.FindProperty(field);
            if (property == null || value == null) return;
            property.objectReferenceValue = value;
        }

        static void SetArray<T>(SerializedObject so, string field, System.Collections.Generic.List<T> values) where T : Object
        {
            var property = so.FindProperty(field);
            if (property == null) return;
            property.arraySize = values.Count;
            for (var i = 0; i < values.Count; i++) property.GetArrayElementAtIndex(i).objectReferenceValue = values[i];
        }
    }
}
